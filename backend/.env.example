# Copy to .env and fill in. Load it however your host expects (export, systemd
# EnvironmentFile, Fly.io secrets, Render env vars, etc.) -- this file itself is
# never read automatically by the app.

# --- Required for real use ---
APEX_JWT_SECRET=                  # generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ANTHROPIC_API_KEY=                # the ONE shared key that pays for every user's usage (this is a free-to-use service)

# --- Database ---
# SQLite is fine for a single small instance / local testing:
APEX_DATABASE_URL=sqlite:///./apex_web.db
# For real hosting, point at a real Postgres instance -- a Supabase Postgres
# connection string works fine here, since this is just SQLAlchemy:
# APEX_DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# --- Cost controls (this is what makes "free" not mean "unlimited") ---
APEX_DAILY_MESSAGE_QUOTA=20
APEX_MAX_ITERATIONS=15
APEX_MODEL=claude-sonnet-4-6

# --- Sandbox isolation: THE critical security setting ---
# "docker"              = real per-user container isolation. REQUIRED for any public deployment.
# "local_dev_INSECURE"  = no isolation between users at all. Local dev/testing ONLY.
APEX_SANDBOX_MODE=local_dev_INSECURE
APEX_DOCKER_IMAGE=python:3.12-slim
APEX_CONTAINER_MEM=512m
APEX_CONTAINER_PIDS=128
APEX_CONTAINER_CPU_QUOTA=50000
APEX_CONTAINER_IDLE_TIMEOUT=600
# "none"   = container has no network at all (safest default -- blocks abuse as an attack proxy,
#            but pip install / git clone won't work inside sandboxes)
# "bridge" = normal outbound network access, at your own risk
APEX_CONTAINER_NETWORK=none
